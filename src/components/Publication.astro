---
import type { Publication } from '../data/publications';

interface Props {
  pub: Publication;
}

const { pub } = Astro.props;
---

<article class="pub">
  <h3 class="title">{pub.title}</h3>
  <p class="authors">{pub.authors}</p>
  <p class="venue">{pub.venue}</p>
  {(pub.doi || pub.arxiv) && (
    <p class="links">
      {pub.doi && <a href={pub.doi} rel="noopener">paper</a>}
      {pub.arxiv && <a href={pub.arxiv} rel="noopener">arXiv</a>}
    </p>
  )}
</article>

<style>
  .pub {
    margin-bottom: 1.85rem;
    max-width: var(--measure-prose);
  }

  .pub:last-child {
    margin-bottom: 0;
  }

  .title {
    margin: 0 0 0.25rem;
    line-height: 1.35;
  }

  .authors {
    margin: 0 0 0.1rem;
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .venue {
    margin: 0;
    font-size: 0.95rem;
    font-style: italic;
    color: var(--text-muted);
  }

  .links {
    display: flex;
    gap: 1.1rem;
    margin: 0.5rem 0 0;
    font-family: var(--font-sans);
    font-size: 0.8rem;
  }
</style>
