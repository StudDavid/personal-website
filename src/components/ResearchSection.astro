---
import type { Area } from '../data/research';

interface Props {
  area: Area;
  /** Ordinal shown on the research page, e.g. "01". Omit on the homepage. */
  index?: number;
  /** Render the full body instead of the one-line summary. */
  full?: boolean;
}

const { area, index, full = false } = Astro.props;
---

<section class="area" id={area.id}>
  {index !== undefined && (
    <p class="ordinal tnum">{String(index).padStart(2, '0')}</p>
  )}
  <h3 class="title">{area.title}</h3>
  {!full && area.summary && <p class="summary">{area.summary}</p>}
  {full &&
    (area.body.length > 0 ? (
      area.body.map((paragraph) => <p>{paragraph}</p>)
    ) : (
      <p class="pending">Full description in preparation.</p>
    ))}
  {full && area.link && (
    <p class="link">
      <a class="more" href={area.link.href} rel="noopener">{area.link.label} →</a>
    </p>
  )}
  <slot />
</section>

<style>
  .area {
    margin-bottom: var(--space-block);
    padding-bottom: var(--space-block);
    border-bottom: 1px solid var(--rule);
    max-width: var(--measure-prose);
  }

  .area:last-of-type {
    border-bottom: none;
    padding-bottom: 0;
    margin-bottom: 0;
  }

  .ordinal {
    font-family: var(--font-sans);
    margin: 0 0 0.4rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    color: var(--text-muted);
  }

  .title {
    margin: 0 0 0.55rem;
  }

  .summary {
    color: var(--text-muted);
  }

  .pending {
    color: var(--text-muted);
    font-style: italic;
  }

  .link {
    margin: 0;
  }

  .link .more {
    margin-top: 0.4rem;
  }

  .area :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
