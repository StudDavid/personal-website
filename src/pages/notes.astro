---
// Not linked from the main navigation on purpose: the page exists so the
// infrastructure is in place, but the site shouldn't advertise a knowledge
// base that doesn't have content yet. Add it to `nav` in src/data/site.ts
// once there is public material.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Notes"
  description="Technical notes and explanatory material by David Theidel."
>
  <header class="page-head">
    <h1>Notes</h1>
    <p class="meta coming">Coming soon.</p>
    <p>I occasionally publish technical notes and explanatory material here.</p>
  </header>
</BaseLayout>

<style>
  .page-head {
    max-width: var(--measure-prose);
  }

  .coming {
    margin-top: 1.15rem;
    margin-bottom: 0.45rem;
  }
</style>
