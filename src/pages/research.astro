---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchSection from '../components/ResearchSection.astro';
import { current, previous } from '../data/research';
---

<BaseLayout
  title="Research"
  description="Research of David Theidel: Rydberg-assisted quantum engineering of light, and previously ultrafast and strong-field quantum optics."
>
  <header class="page-head">
    <h1>Research</h1>
    <p class="lead">
      I work on the quantum optical properties of light produced or shaped by
      strongly driven and strongly interacting systems. My doctoral work was on
      high-harmonic generation in semiconductors, and I now work with Rydberg
      atoms at the Collège de France.
    </p>
  </header>

  <section class="section">
    <h2 class="section-label">Current</h2>
    {current.map((area, i) => <ResearchSection area={area} index={i + 1} full />)}
  </section>

  <section class="section">
    <h2 class="section-label">Previous</h2>
    {previous.map((area, i) => (
      <ResearchSection area={area} index={current.length + i + 1} full />
    ))}
  </section>
</BaseLayout>

