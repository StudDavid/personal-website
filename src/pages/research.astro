---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchSection from '../components/ResearchSection.astro';
import { current, previous } from '../data/research';
---

<BaseLayout
  title="Research"
  description="Research of David Theidel: Rydberg-assisted quantum engineering of light, and previously ultrafast and strong-field quantum optics."
>
  <header class="page-head">
    <h1>Research</h1>
    {/*
      TODO: your intro paragraph goes here, e.g.
      <p class="lead">...</p>
      The per-area text lives in src/data/research.ts.
    */}
  </header>

  <section class="section">
    <h2 class="section-label">Current</h2>
    {current.map((area, i) => <ResearchSection area={area} index={i + 1} full />)}
  </section>

  <section class="section">
    <h2 class="section-label">Previous</h2>
    {previous.map((area, i) => (
      <ResearchSection area={area} index={current.length + i + 1} full />
    ))}
  </section>
</BaseLayout>

