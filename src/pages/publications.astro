---
import BaseLayout from '../layouts/BaseLayout.astro';
import Publication from '../components/Publication.astro';
import { publications, byYear } from '../data/publications';
import { contact } from '../data/site';

const groups = byYear(publications);
---

<BaseLayout
  title="Publications"
  description="Publications by David Theidel in quantum optics, ultrafast science and strong-field physics."
>
  <header class="page-head">
    <h1>Publications</h1>
    <p class="meta also">
      {/* One line on purpose: a newline between an element and text is
          trimmed, which swallows the space. */}
      Also on <a href={contact.scholar} rel="noopener">Google Scholar</a> and <a href={contact.orcid} rel="noopener">ORCID</a>.
    </p>
  </header>

  {groups.length === 0 ? (
    <p class="meta">The publication list is being compiled.</p>
  ) : (
    groups.map((group) => (
      <section class="year-group">
        <h2 class="year tnum">{group.year}</h2>
        {group.items.map((pub) => <Publication pub={pub} />)}
      </section>
    ))
  )}
</BaseLayout>

<style>
  .page-head {
    margin-bottom: 2.75rem;
  }

  .also {
    margin-top: 0.85rem;
    font-size: 0.95rem;
  }

  .year-group {
    margin-bottom: 2.75rem;
  }

  .year-group:last-of-type {
    margin-bottom: 0;
  }

  .year {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--text-muted);
    margin: 0 0 1.15rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--rule);
  }
</style>
