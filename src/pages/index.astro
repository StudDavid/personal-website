---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchSection from '../components/ResearchSection.astro';
import Publication from '../components/Publication.astro';
import MailLink from '../components/MailLink.astro';
import { site, contact } from '../data/site';
import { current, previous } from '../data/research';
import { selected, byYear } from '../data/publications';
import { url } from '../lib/url';

const selectedByYear = byYear(selected);
---

<BaseLayout>
  <header class="identity">
    <h1>{site.name}</h1>
    <p class="role">{site.role}</p>
    <p class="affiliation">{site.affiliation}</p>
    <p class="lead statement">
      I study quantum optical phenomena in strongly driven and strongly
      interacting systems. My doctoral work focused on ultrafast optics and
      quantum optics with high-harmonic generation in semiconductors.
      Currently, I work on quantum gates, Rydberg atoms, collective
      light–matter interaction, and non-classical light.
    </p>
  </header>

  <section class="section">
    <h2 class="section-label">Research</h2>

    <div class="group">
      <p class="sub-label">Current research</p>
      {current.map((area) => <ResearchSection area={area} />)}
    </div>

    <div class="group">
      <p class="sub-label">Previous research</p>
      {previous.map((area) => <ResearchSection area={area} />)}
    </div>

    <a class="more" href={url('/research/')}>All research →</a>
  </section>

  <section class="section">
    <h2 class="section-label">Selected publications</h2>
    {selectedByYear.length === 0 ? (
      <p class="meta">Publication list in preparation.</p>
    ) : (
      selectedByYear.map((group) => (
        <div class="year-group">
          <p class="year tnum">{group.year}</p>
          {group.items.map((pub) => <Publication pub={pub} />)}
        </div>
      ))
    )}
    <a class="more" href={url('/publications/')}>All publications →</a>
  </section>

  <section class="section">
    <h2 class="section-label">Currently</h2>
    <p class="prose">
      Since March 2026 I have been a postdoctoral researcher at the Collège de
      France in Paris. As a member of the JEIP Quantum Photonics team of
      Alexei Ourjoumtsev, I work on Rydberg-assisted quantum engineering of
      light.
    </p>
    <a class="more" href={url('/cv/')}>Curriculum vitae →</a>
  </section>

  <section class="section">
    <h2 class="section-label">Contact</h2>
    <p class="contact-links">
      <MailLink />
      <span aria-hidden="true">·</span>
      <a href={contact.scholar} rel="me noopener">Google Scholar</a>
      <span aria-hidden="true">·</span>
      <a href={contact.orcid} rel="me noopener">ORCID</a>
    </p>
  </section>
</BaseLayout>

<style>
  .identity {
    padding-top: clamp(2.75rem, 2rem + 2.5vw, 4rem);
  }

  .role {
    margin: 0.9rem 0 0;
    font-size: 1.08rem;
  }

  .affiliation {
    margin: 0.15rem 0 0;
    color: var(--text-muted);
  }

  .statement {
    margin-top: 1.6rem;
  }

  /* Current / Previous groupings inside the research section. */
  .group + .group {
    margin-top: var(--space-block);
    padding-top: var(--space-block);
    border-top: 1px solid var(--rule);
  }

  .year-group {
    margin-bottom: 1.85rem;
  }

  .year-group:last-of-type {
    margin-bottom: 0;
  }

  .year {
    font-family: var(--font-sans);
    margin: 0 0 0.7rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
</style>
