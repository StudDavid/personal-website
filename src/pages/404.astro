---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
---

<BaseLayout title="Page not found" description="Page not found.">
  <div class="page-head">
    <h1>404</h1>
    <p class="meta">This page does not exist.</p>
    <p><a class="more" href={url('/')}>Return home →</a></p>
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-top: clamp(3rem, 2.4rem + 2vw, 4.5rem);
  }

  .meta {
    margin-top: 1rem;
  }
</style>
