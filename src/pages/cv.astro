---
import BaseLayout from '../layouts/BaseLayout.astro';
import Publication from '../components/Publication.astro';
import { cv } from '../data/cv';
import { publications, byYear } from '../data/publications';
import { site } from '../data/site';
import { url } from '../lib/url';

const groups = byYear(publications);
// Drop the download link if no PDF has been added yet.
const hasPdf = false; // set to true once public/files/cv.pdf exists
---

<BaseLayout
  title="CV"
  description={`Curriculum vitae of ${site.name}, postdoctoral researcher in quantum optics at the Collège de France.`}
>
  <header class="page-head">
    <h1>Curriculum Vitae</h1>
    {hasPdf && (
      <p><a href={url('/files/cv.pdf')}>Download CV (PDF)</a></p>
    )}
  </header>

  {cv.map((section) => (
    <section class="section">
      <h2 class="section-label">{section.label}</h2>
      <dl class="entries">
        {section.entries.map((entry) => (
          <div class="entry">
            <dt class="when">{entry.when}</dt>
            <dd class="what">
              <span class="what-line">{entry.what}</span>
              {entry.where && <span class="where">{entry.where}</span>}
              {entry.detail && <span class="detail">{entry.detail}</span>}
            </dd>
          </div>
        ))}
      </dl>
    </section>
  ))}

  <section class="section">
    <h2 class="section-label">Publications</h2>
    {groups.length === 0 ? (
      <p class="meta">The publication list is being compiled.</p>
    ) : (
      groups.map((group) => (
        <div class="year-group">
          <p class="year">{group.year}</p>
          {group.items.map((pub) => <Publication pub={pub} />)}
        </div>
      ))
    )}
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-top: 3.5rem;
  }

  .page-head p {
    margin-top: 1rem;
    font-size: 0.925rem;
  }

  .entries {
    margin: 0;
  }

  .entry {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 0 1.5rem;
    margin-bottom: 1.5rem;
  }

  .entry:last-child {
    margin-bottom: 0;
  }

  .when {
    margin: 0;
    font-size: 0.875rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    padding-top: 0.15rem;
  }

  .what {
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .what-line {
    font-weight: 600;
  }

  .where,
  .detail {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .year-group {
    margin-bottom: 2rem;
  }

  .year {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  /* Stack the date above the entry on narrow screens. */
  @media (max-width: 34rem) {
    .entry {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }

    .when {
      padding-top: 0;
      order: -1;
    }
  }
</style>
