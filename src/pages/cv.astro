---
import BaseLayout from '../layouts/BaseLayout.astro';
import Publication from '../components/Publication.astro';
import { cv } from '../data/cv';
import { publications, byYear } from '../data/publications';
import { site } from '../data/site';
import { url } from '../lib/url';

const groups = byYear(publications);
// Set to true once public/files/cv.pdf exists.
const hasPdf = false;
---

<BaseLayout
  title="CV"
  description={`Curriculum vitae of ${site.name}, researcher in quantum optics at the Collège de France.`}
>
  <header class="page-head">
    <h1>Curriculum Vitae</h1>
    {hasPdf && (
      <p class="download"><a href={url('/files/cv.pdf')}>Download CV (PDF)</a></p>
    )}
  </header>

  {cv.map((section) => (
    <section class="section">
      <h2 class="section-label">{section.label}</h2>
      <dl class="entries">
        {section.entries.map((entry) => (
          <div class="entry">
            <dt class="when tnum">{entry.when}</dt>
            <dd class="what">
              <span class="what-line">{entry.what}</span>
              {entry.where && <span class="where">{entry.where}</span>}
              {entry.detail && <span class="detail">{entry.detail}</span>}
            </dd>
          </div>
        ))}
      </dl>
    </section>
  ))}

  <section class="section">
    <h2 class="section-label">Publications</h2>
    {groups.length === 0 ? (
      <p class="meta">The publication list is being compiled.</p>
    ) : (
      groups.map((group) => (
        <div class="year-group">
          <p class="year tnum">{group.year}</p>
          {group.items.map((pub) => <Publication pub={pub} />)}
        </div>
      ))
    )}
  </section>
</BaseLayout>

<style>

  .download {
    margin-top: 0.9rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
  }

  .entries {
    margin: 0;
  }

  .entry {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 0 1.75rem;
    margin-bottom: 1.4rem;
  }

  .entry:last-child {
    margin-bottom: 0;
  }

  .when {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: var(--text-muted);
    padding-top: 0.28rem;
  }

  .what {
    margin: 0;
    display: flex;
    flex-direction: column;
    max-width: var(--measure-prose);
  }

  .what-line {
    font-weight: 650;
  }

  .where {
    color: var(--text-muted);
  }

  .detail {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-top: 0.15rem;
  }

  .year-group {
    margin-bottom: 1.85rem;
  }

  .year-group:last-of-type {
    margin-bottom: 0;
  }

  .year {
    font-family: var(--font-sans);
    margin: 0 0 0.7rem;
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  /* Stack the date above the entry when the column would crowd the text. */
  @media (max-width: 34rem) {
    .entry {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }

    .when {
      padding-top: 0;
      order: -1;
    }
  }
</style>
